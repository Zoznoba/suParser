DATABASE_URL=postgresql+asyncpg://hr:hr@localhost:5432/hr
REDIS_URL=redis://localhost:6379/0

# SuperJob API (https://api.superjob.ru/register): client_id и secret key приложения
SUPERJOB_APP_ID=
SUPERJOB_SECRET=
# аккаунт работодателя, от имени которого ищем резюме (и в API, и на сайте)
SUPERJOB_LOGIN=
SUPERJOB_PASSWORD=
# mock — фейковые резюме (разработка); api — официальный API; browser — сайт через Playwright
SUPERJOB_MODE=mock

# браузерные парсеры (SUPERJOB_MODE=browser, hh.ru)
BROWSER_HEADLESS=true
BROWSER_MIN_DELAY=8
BROWSER_MAX_DELAY=20
BROWSER_DAILY_PAGE_LIMIT=150
SUPERJOB_WEB_MAX_PAGES=3

# hh.ru: вход работодателя — кнопкой «Войти» в интерфейсе (Поиск → Источники) или uv run python -m app.cli browser-login hh
HH_MAX_PAGES=2
# резюме, обновлённые за последние N дней (0, 1, 3, 7, 14, 30, 365; 0 — все), по релевантности
HH_SEARCH_PERIOD_DAYS=3
HH_OPEN_RESUMES=true
# true — без входа работодателя hh встаёт на паузу, а не собирает урезанные резюме
HH_REQUIRE_LOGIN=true

# LinkedIn через Apify (без своего аккаунта LinkedIn): токен — console.apify.com → Settings → API & Integrations.
# Без токена источник выключен. $0.10 за страницу поиска (до 25 профилей), бесплатный план — $5 в месяц.
APIFY_TOKEN=
# Short — карточка из выдачи; Full — ещё опыт, образование, навыки (+$0.004 за профиль)
LINKEDIN_PROFILE_MODE=Short
# фильтр по месту жительства, как в LinkedIn: Russia, Moscow… (пусто — весь мир)
LINKEDIN_LOCATION=
LINKEDIN_MAX_PAGES=1
# страниц поиска в сутки на все профили вместе: 1 в день ≈ $3 в месяц
LINKEDIN_DAILY_PAGE_LIMIT=1
